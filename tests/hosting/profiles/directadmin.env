# DirectAdmin + Exim + Dovecot. Pipe em /etc/virtual/<domínio>/aliases
# (exige allow_forwarder_pipe=1), rodando como o dono do domínio, grupo mail.
HOSTING_LABEL="DirectAdmin (Exim + Dovecot)"
MTA=exim
EXIM_FLAVOR=directadmin
ACCOUNT_USER=dauser
MAILDIR=/home/dauser/imap/forum.test/reply/Maildir
PIPE_PHP=/usr/local/bin/php
PIPE_SCRIPT=/home/dauser/forward-to-flarum.php
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=1
PHP_DISABLE_FUNCTIONS="exec,passthru,shell_exec,system,popen,pcntl_exec,show_source"
# open_basedir ligado por padrão no DirectAdmin.
PHP_OPEN_BASEDIR=__FORUM__:/tmp:/var/tmp
PHP_MEMORY_LIMIT=256M
