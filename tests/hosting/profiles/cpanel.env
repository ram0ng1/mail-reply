# cPanel + Exim + Dovecot (CloudLinux/CageFS). Pipe pelo "Pipe to a Program"
# do Forwarders, rodando como o usuário da conta; caixa em ~/mail/<domínio>.
HOSTING_LABEL="cPanel (Exim + Dovecot)"
MTA=exim
EXIM_FLAVOR=cpanel
ACCOUNT_USER=cpuser
MAILDIR=/home/cpuser/mail/forum.test/reply
PIPE_PHP=/usr/local/bin/php
PIPE_SCRIPT=/home/cpuser/forward-to-flarum.php
IMAP_PORT=993
IMAP_ENCRYPTION=ssl
IMAP_VALIDATE_CERT=1
# CloudLinux costuma desligar estas funções no PHP da conta (web e CLI).
PHP_DISABLE_FUNCTIONS="exec,passthru,shell_exec,system,popen,pcntl_exec"
PHP_OPEN_BASEDIR=
PHP_MEMORY_LIMIT=128M
