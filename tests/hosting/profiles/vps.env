# VPS sem painel: Postfix + Dovecot LMTP, certificado autoassinado, PHP sem
# restrições.
HOSTING_LABEL="VPS (Postfix + Dovecot, sem painel)"
MTA=postfix
ACCOUNT_USER=vmail
MAILDIR=/var/vmail/forum.test/reply
PIPE_PHP=/usr/bin/php
PIPE_SCRIPT=/usr/local/bin/forward-to-flarum.php
IMAP_PORT=143
IMAP_ENCRYPTION=tls
IMAP_VALIDATE_CERT=0
PHP_DISABLE_FUNCTIONS=
PHP_OPEN_BASEDIR=
PHP_MEMORY_LIMIT=512M
