# Plesk + Postfix + Dovecot. Caixa em /var/qmail/mailnames; pipe só com
# root (alias do Postfix); PHP da Plesk em /opt/plesk/php; IMAP com STARTTLS.
HOSTING_LABEL="Plesk (Postfix + Dovecot)"
MTA=postfix
ACCOUNT_USER=popuser
MAILDIR=/var/qmail/mailnames/forum.test/reply/Maildir
PIPE_PHP=/opt/plesk/php/8.3/bin/php
PIPE_SCRIPT=/var/www/vhosts/forum.test/forward-to-flarum.php
IMAP_PORT=143
IMAP_ENCRYPTION=tls
IMAP_VALIDATE_CERT=1
PHP_DISABLE_FUNCTIONS="opcache_get_status"
# open_basedir padrão da Plesk: {WEBSPACEROOT}{/}{:}{TMP}{/}
PHP_OPEN_BASEDIR=__FORUM__:/tmp
PHP_MEMORY_LIMIT=128M
